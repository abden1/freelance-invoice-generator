# Database (PostgreSQL - use Neon, Supabase, or Railway)
DATABASE_URL="postgresql://user:password@host:5432/freelance_db?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-32-char-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Stripe (dashboard.stripe.com)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_BUSINESS_PRICE_ID="price_..."

# Resend (resend.com)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@yourdomain.com"

# Vercel Blob (vercel.com/storage/blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Exchange Rate API (exchangerate-api.com - free tier available)
EXCHANGE_RATE_API_KEY="your-exchange-rate-api-key"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
